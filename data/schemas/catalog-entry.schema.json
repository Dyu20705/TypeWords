{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewords.cc/schemas/catalog-entry.schema.json",
  "title": "CatalogEntry",
  "description": "Schema contract for dictionary catalog items in TypeWords",
  "type": "object",
  "required": ["id", "name", "description", "category", "tags", "url", "length", "language", "translateLanguage"],
  "properties": {
    "id": { "type": ["string", "number"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "url": { "type": "string", "minLength": 1 },
    "length": { "type": "integer", "minimum": 0 },
    "language": { "type": "string" },
    "translateLanguage": { "type": "string" },
    "recommended": { "type": "boolean" },
    "cover": { "type": "string" }
  },
  "additionalProperties": true
}
